{
  "name": "roshandash.com",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Roshan Dash \u2014 personal site: writing, notes and a captcha-gated contact card.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir pagefind && node scripts/content-guard.mjs",
    "guard": "node scripts/content-guard.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "seal-contact": "node scripts/seal-contact.mjs",
    "make-icons": "node scripts/make-icons.mjs",
    "new:post": "node scripts/new-entry.mjs post",
    "new:trade": "node scripts/new-entry.mjs trade",
    "new:note": "node scripts/new-entry.mjs note"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "^7.4.7",
    "astro-expressive-code": "^0.44.3",
    "satori": "^0.63.2",
    "satteri-callouts": "^1.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "pagefind": "^1.6.0",
    "typescript": "^6.0.3"
  }
}
