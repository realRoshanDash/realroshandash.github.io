---
/**
 * The hero: the Dash sandwich (design spec §4.11, geometry validated in Chromium and WebKit).
 * Everything derives from --F, the name's font size: the plate runs from the cap line of "Roshan" for 2F at the
 * photo's own ratio, so the dash — an en dash at Inter's real metrics, drawn as ::after of "Dash" — always crosses
 * it at 64% of the image height: the shoulder line, never the face. On desktop F is locked to the grid ("Roshan"
 * fills cols 1–8) and the plate is exactly cols 9–12. Layers share the .hero stacking context:
 * backdrop (1) → name + dash (2) → cut-out (3) → frame edge, crop marks, caption (4).
 * The page renders in its final layout; only the dash, the crop marks and the grid draw in on a session's first view.
 */
import { getImage } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import cutout from '@/assets/portrait-cutout.png';
import { PORTRAIT_ALT, SITE } from '@/data/site';
import { linkTo } from '@/lib/routes';

interface Props {
  hasPosts: boolean;
}
const { hasPosts } = Astro.props;
const writing = linkTo('/blog/', '#writing');
const contact = linkTo('/contact/', '#contact');
const about = linkTo('/about/', '#about');

// The portrait (spec §6.1, budgets §8.4: ≤ 60 KB on a 2x desktop, ≤ 15 KB on a phone). At its native 760w the
// cut-out keeps fine grain that AVIF spends ~66 KB on at q60, so that one size is encoded at q45 (~28 KB). Phones
// never need more than 570w (2.2x of their ~257px plate), so they get their own capped sources.
const WIDTHS = [380, 570, 760] as const;
const quality = (width: number) => (width > 570 ? 45 : 60);
const variants = (format: 'avif' | 'webp') =>
  Promise.all(WIDTHS.map((width) => getImage({ src: cutout, width, format, quality: quality(width) })));
const [avif, webp] = await Promise.all([variants('avif'), variants('webp')]);
const srcset = (images: { src: string }[], count = images.length) =>
  images.slice(0, count).map((image, i) => `${image.src} ${WIDTHS[i]}w`).join(', ');
const SIZES = '(min-width: 1024px) min(30.3vw, 451px), 46vw';
const PHONE = '(max-width: 639px)';
---

<section class="hero" aria-labelledby="hero-name">
  <div class="wrap g hero__grid">
    <ol class="hero__ruler" aria-hidden="true">{Array.from({ length: 12 }, (_, i) => <li>{String(i + 1).padStart(2, '0')}</li>)}</ol>
    <dl class="hero__meta">
      <div><dt class="label">Role</dt>{' '}<dd>Software engineer</dd></div>
      <div><dt class="label">Focus</dt>{' '}<dd>Java, distributed systems, databases</dd></div>
      <div><dt class="label">Practice</dt>{' '}<dd>AI agents, agentic workflows</dd></div>
      <div><dt class="label">Local time</dt>{' '}<dd><span class="clock" data-clock>UTC+08:00</span></dd></div>
    </dl>
    <!-- the space between the spans matters: the accessible name must be "Roshan Dash", not "RoshanDash" -->
    <h1 class="hero__name" id="hero-name"><span class="line">Roshan</span>{' '}<span class="line line--dash">Dash</span></h1>
    <figure class="hero__plate" aria-labelledby="fig-01">
      <div class="plate__clip" data-plate>
        <div class="plate__frame">
          <div class="plate__backdrop"></div>
          <picture>
            <source type="image/avif" media={PHONE} srcset={srcset(avif, 2)} sizes="66vw" />
            <source type="image/avif" srcset={srcset(avif)} sizes={SIZES} />
            <source type="image/webp" media={PHONE} srcset={srcset(webp, 2)} sizes="66vw" />
            <img
              class="plate__img"
              src={webp[2].src}
              srcset={srcset(webp)}
              sizes={SIZES}
              width={cutout.width}
              height={cutout.height}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              alt={PORTRAIT_ALT}
            />
          </picture>
        </div>
      </div>
      <span class="crop crop--tl" aria-hidden="true"></span><span class="crop crop--tr" aria-hidden="true"></span>
      <span class="crop crop--bl" aria-hidden="true"></span><span class="crop crop--br" aria-hidden="true"></span>
      <figcaption class="plate__cap label" id="fig-01">Fig. 01 — {SITE.name}</figcaption>
    </figure>
    <div class="hero__intro">
      <p class="t-lede hero__lede"><strong>Software engineer in {SITE.location}.</strong> I&nbsp;design and build backend systems, with AI agents in the loop from design to ship.</p>
      <div class="hero__cta">
        {hasPosts ? (
          <>
            <Button variant="primary" href={writing} icon="arrow-right">Read the writing</Button>{' '}
            <Button href={contact} icon="arrow-right">Get in touch</Button>
          </>
        ) : (
          <>
            <Button variant="primary" href={contact} icon="arrow-right">Get in touch</Button>{' '}
            <Button href={about} icon="arrow-right">About me</Button>
          </>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow-x: clip;
    container-type: inline-size;   /* 100cqi = the hero's width, without the scrollbar */
    --gap-name: clamp(32px, 4vw, 56px);
  }
  /* --F, the name's font size, drives the whole sandwich. On desktop it is locked to the grid: "Roshan" is 3.0943F of
     ink, so at F = (width of cols 1–8) / 3.0943 it fills cols 1–8 exactly, and the 2F-tall print (1.5016F wide) then
     fills cols 9–12 to within a pixel. It turns height-bound on short screens so the CTAs stay in the first viewport,
     and the plate keeps to cols 9–12 regardless (see the ≥1024px block). Defined here, not on .hero, because cqi
     resolves against the nearest container *above* the element that uses it. */
  .hero__grid {
    --w8: calc((min(100cqi, var(--maxw)) - 2 * var(--margin)) * 2 / 3 - var(--gutter) / 3);
    --F: clamp(120px, min(calc(var(--w8) / 3.0943), calc((100svh - 380px) / 1.68)), 300px);
    padding-bottom: clamp(32px, 3vw, 40px);
  }

  .hero__ruler {
    grid-column: 1 / -1; grid-row: 1;
    display: grid; grid-template-columns: subgrid;
    padding-top: 16px; list-style: none;
  }
  .hero__ruler li {
    padding-left: 7px;
    font-size: 12px; line-height: 16px; font-weight: 500; letter-spacing: 0.08em;
    color: var(--fg-3); font-variant-numeric: tabular-nums;
  }

  .hero__meta {
    grid-column: 1 / -1; grid-row: 2;
    display: grid; grid-template-columns: subgrid;
    margin-top: 12px; padding-top: 14px;
    border-top: 1px solid var(--rule);
  }
  .hero__meta > div { grid-column: span 3; display: flex; flex-direction: column; gap: 6px; }
  .hero__meta dd { font-size: 15px; line-height: 20px; font-weight: 500; letter-spacing: -0.012em; }
  .clock { display: inline-block; min-inline-size: 9ch; font-variant-numeric: tabular-nums; }

  /* The name may wrap, so it can never slide under the portrait: with the WCAG 1.4.12 text-spacing overrides
     "Roshan" no longer fits cols 1–8 and breaks instead of running behind the cut-out (spec §2.3.3). The
     -0.04em right margin is the slack that keeps it on one line at normal spacing: its box (side bearings and
     the last letter's tracking included) is a hair wider than the 3.0943em of ink that F is fitted to. */
  .hero__name {
    grid-column: 1 / 9; grid-row: 3;
    position: relative; z-index: var(--z-plate-type);
    margin: var(--gap-name) -0.04em 0 -0.0543em;   /* optical alignment: the ink of R / D on the column line */
    font-size: var(--F); line-height: 0.84; font-weight: 700; letter-spacing: -0.05em;
    white-space: normal; overflow-wrap: anywhere;
    font-variation-settings: 'opsz' 32;
  }
  .hero__name .line { display: block; }
  /* THE DASH */
  .hero__name .line--dash::after {
    content: ''; display: inline-block;
    width: 100vw; margin-right: -100vw;   /* runs off the right edge, takes no inline space */
    height: 0.1156em; margin-left: 0.12em;  /* Inter en-dash thickness at opsz 32 / wght 700 */
    vertical-align: 0.2288em;               /* bottom edge; centre = .2866em above the baseline */
    background: var(--signal);
    transform-origin: left center;
  }

  .hero__plate {
    grid-column: 9 / 13; grid-row: 3 / span 2;
    justify-self: end; align-self: start;
    position: relative;
    margin: calc(var(--gap-name) + 0.0562 * var(--F)) 0 0;   /* = the cap line of "Roshan" */
    height: calc(2 * var(--F));
    aspect-ratio: 760 / 1012;
  }
  .plate__clip { position: absolute; inset: 0; overflow: hidden; }
  /* native ratio; crops from the bottom when the plate is shorter */
  .plate__frame { position: absolute; left: 0; top: 0; width: 100%; aspect-ratio: 760 / 1012; }
  .plate__backdrop { position: absolute; inset: 0; z-index: var(--z-plate-back); background: var(--portrait-backdrop); }
  .plate__img {
    position: absolute; inset: 0; z-index: var(--z-plate-front);
    width: 100%; height: 100%;
  }
  /* print edge; the bar passes under it */
  .hero__plate::after {
    content: ''; position: absolute; inset: 0; z-index: var(--z-plate-ornament);
    border: 1px solid var(--plate-edge);
    pointer-events: none;
  }
  /* 32px below the print, clear of the crop marks (they reach 24px out) */
  .plate__cap { position: absolute; z-index: var(--z-plate-ornament); left: 0; top: calc(100% + 32px); white-space: nowrap; }

  .crop { position: absolute; z-index: var(--z-plate-ornament); width: 16px; height: 16px; pointer-events: none; }
  .crop::before, .crop::after { content: ''; position: absolute; background: var(--fg-3); }
  .crop::before { left: 0; bottom: 0; width: 16px; height: 1px; }
  .crop::after { right: 0; top: 0; width: 1px; height: 16px; }
  .crop--tl { left: -24px; top: -24px; }
  .crop--bl { left: -24px; bottom: -24px; transform: scaleY(-1); }
  /* the right-hand marks stay inside the page margin, whatever its width */
  .crop--tr, .crop--br { right: calc(-1 * min(24px, var(--margin) - 6px)); }
  .crop--tr { top: -24px; transform: scaleX(-1); }
  .crop--br { bottom: -24px; transform: scale(-1, -1); }

  .hero__intro { grid-column: 1 / 8; grid-row: 4; padding-top: clamp(24px, 2.4vw, 32px); }
  .hero__lede { max-width: 34em; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }

  @media (width >= 1024px) {
    /* The plate is exactly cols 9–12 and 2F tall. The print keeps its native ratio and sits flush right, so the hard
       crop of the cut-out (the shoulder leaving the frame) stays on the plate edge, and the studio light carries on
       to the left wherever the plate is wider than the print (F capped, or height-bound on a short screen); the
       cut-out's left arm fades out in the asset itself, so no cut shows there. The gradient is the token's own
       ellipse, sized and placed in F from the right, so the tones behind the hair don't change. The bar still crosses
       at 0.64 of the height: the shoulder line. */
    .hero__plate { justify-self: stretch; aspect-ratio: auto; }
    .plate__frame { left: auto; right: 0; width: calc(1.5016 * var(--F)); }
    .plate__backdrop {
      left: -200%;
      background: radial-gradient(calc(1.2013 * var(--F)) calc(1.4 * var(--F)) at calc(100% - 0.8259 * var(--F)) calc(0.64 * var(--F)),
        var(--portrait-backdrop-stops));
    }
    /* each CTA spans two of the intro's seven columns (it never shrinks below its label) */
    .hero__cta {
      display: grid; column-gap: var(--gutter);
      grid-template-columns: repeat(2, minmax(calc((100% - 6 * var(--gutter)) / 7 * 2 + var(--gutter)), max-content));
    }
  }
  /* Below 900px tall F is height-bound, and the ~40px ruler would push both CTAs past the fold (spec §4.11): it goes.
     F reads only 100svh, so the dash stays on the shoulder line. */
  @media (width >= 1024px) and (height < 900px) { .hero__ruler { display: none; } }
  /* 1366×768 laptops with browser chrome (≈657px tall): the meta row repeats the lede, so it goes too and F gets the room */
  @media (width >= 1024px) and (height < 720px) {
    .hero__meta { display: none; }
    .hero__grid { --F: clamp(120px, min(calc(var(--w8) / 3.0943), calc((100svh - 300px) / 1.68)), 300px); }
  }

  /* tablet: stacked; plate beside the intro, both hanging from the same top line */
  @media (width < 1024px) {
    .hero__grid { --F: min(22vw, 200px); }
    .hero__name { grid-column: 1 / -1; }
    .hero__plate { grid-column: 5 / 9; grid-row: 4; margin-top: 24px; width: 100%; height: auto; }
    .hero__intro { grid-column: 1 / 5; grid-row: 4; align-self: start; padding-top: 24px; }
    .hero__meta > div { grid-column: span 4; }
    .hero__meta > div:nth-child(n + 3) { display: none; }
    .hero__ruler li:nth-child(n + 9) { display: none; }
  }
  /* room under the plate for the caption */
  @media (640px <= width < 1024px) { .hero__grid { padding-bottom: 64px; } }

  /* phone: name → plate (cols 2–4, caption vertical in col 1) → lede → two CTAs, all inside 844px */
  @media (width < 640px) {
    .hero { --gap-name: 20px; }
    .hero__grid { --F: min(26.6vw, 112px); }
    .hero__ruler { display: none; }
    .hero__meta { margin-top: 0; }
    .hero__meta > div { grid-column: span 2; }
    .hero__meta > div:nth-child(2), .hero__meta > div:nth-child(3) { display: none; }
    .hero__meta > div:nth-child(4) { display: flex; }
    .hero__meta dd { font-size: 14px; }
    .hero__plate {
      --pw: calc(0.75 * (100cqi - 2 * var(--margin)) - 0.25 * var(--gutter)); /* width of cols 2–4 */
      grid-column: 2 / 5; grid-row: 4;
      margin-top: 20px;
      width: var(--pw);
      aspect-ratio: auto;
      height: clamp(calc(var(--pw) * 0.879), calc(100svh - 330px - 1.68 * var(--F)), calc(var(--pw) * 1.3316));
    }
    .plate__cap {
      left: auto; top: auto; right: calc(100% + 10px); bottom: 0;
      writing-mode: vertical-rl; transform: rotate(180deg);
      max-inline-size: 100%; overflow: hidden;   /* never taller than the plate */
    }
    .crop { display: none; }
    .hero__intro { grid-column: 1 / -1; grid-row: 5; padding-top: 16px; }
    .hero__lede { font-size: 16px; line-height: 1.45; }
    /* side by side; they wrap only if their labels can't fit (e.g. with enlarged text spacing) */
    .hero__cta { margin-top: 16px; }
    .hero__cta :global(.btn) { flex: 1 1 0; padding: 0 16px; }
  }
  @media (width < 360px) { .hero__cta :global(.btn) { gap: 8px; padding: 0 12px; } }

  /* Windows High Contrast and other forced palettes: no per-line backplate over the lede, and the dash stays visible */
  @media (forced-colors: active) {
    .hero__name { forced-color-adjust: none; color: CanvasText; }
    .hero__name .line--dash::after { background: CanvasText; }
  }
</style>
