---
/** Profile facts: a ruled, indexed definition list (design spec §4.13). Facts from site.ts only. */
import Icon from '@/components/ui/Icon.astro';
import { SITE, SOCIALS } from '@/data/site';
---

<dl class="facts" data-reveal="1">
  <div><dt class="label">Discipline</dt><dd>Software engineering<span class="sub">&nbsp;— Java, distributed systems, databases, system design.</span></dd><dd class="idx" aria-hidden="true">A.1</dd></div>
  <div><dt class="label">Practice</dt><dd>AI agents and agentic workflows<span class="sub">&nbsp;— across design, build and ship.</span></dd><dd class="idx" aria-hidden="true">A.2</dd></div>
  <div><dt class="label">Education</dt><dd>{SITE.alumni}<span class="sub">&nbsp;— alumnus.</span></dd><dd class="idx" aria-hidden="true">A.3</dd></div>
  <div><dt class="label">Based in</dt><dd>{SITE.location}<span class="sub">&nbsp;— SGT, UTC+08:00.</span></dd><dd class="idx" aria-hidden="true">A.4</dd></div>
  <div>
    <dt class="label">Elsewhere</dt>
    <dd>{SOCIALS.map((s) => <a class="ext-link" href={s.href} rel="me noopener">{s.label}<Icon name="arrow-up-right" /></a>)}</dd>
    <dd class="idx" aria-hidden="true">A.5</dd>
  </div>
</dl>

<style>
  .facts { grid-column: 3 / 13; border-bottom: 1px solid var(--rule); }
  /* the rows sit on the page grid (10 of its 12 columns on desktop, all 8 on tablet), label, value and index on one baseline */
  .facts > div {
    display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); column-gap: var(--gutter);
    align-items: baseline;
    padding: 16px 0 18px;
    border-top: 1px solid var(--rule);
  }
  .facts dt { grid-column: 1 / 3; }
  .facts dd { grid-column: 3 / 9; font-size: 17px; line-height: 1.45; }
  .facts dd .sub { color: var(--fg-2); }
  .facts dd a {
    display: inline-flex; gap: 6px; align-items: center;
    margin-right: 22px; min-height: 32px;
    border-bottom: 1px solid var(--rule-2);
    transition: border-color var(--dur-2) linear;
  }
  .facts dd a:hover { border-color: var(--signal-ui); }
  .facts .idx { grid-column: 9 / 11; justify-self: end; font-size: 13px; color: var(--fg-3); font-variant-numeric: tabular-nums; }
  @media (width < 1024px) {
    .facts { grid-column: 1 / -1; }
    .facts > div { grid-template-columns: repeat(8, minmax(0, 1fr)); }
    .facts dt { grid-column: 1 / 3; }
    .facts dd { grid-column: 3 / 8; }
    .facts .idx { grid-column: 8; }
  }
  @media (width < 640px) {
    .facts > div { grid-template-columns: 1fr; row-gap: 6px; }
    .facts dt, .facts dd { grid-column: 1; }
    .facts .idx { display: none; }
  }
</style>
