---
/**
 * Price-level ladder (design spec §4.21): every planned level on one vertical price axis, with its R-multiple.
 * Risk (entry ↔ stop) is hatched, reward (entry ↔ furthest target) lightly tinted, and the axis carries a tick
 * every R. Positions are computed at build time (model.ts); text is set in CSS pixels, so it stays legible from
 * a 320px phone to a wide desktop. Two levels too close to label apart get their labels nudged, with a leader
 * back to the true price. The figure is one image with a spoken label, and the same data is a table below.
 */
import { formatPrice, formatR } from '@/lib/format';
import { ladderLabel, ladderModel, type LadderInput } from './model';

interface Props {
  trade: LadderInput;
  /** Unique per page: ids for the caption and the table. */
  id?: string;
}
const { trade, id = 'ladder' } = Astro.props;
const model = ladderModel(trade);
const pct = (value: number) => `${value.toFixed(3)}%`;
const label = ladderLabel(model);
// The table lists levels highest price first, as the figure does.
const rows = model.levels;
---

<figure class="ladder-box" aria-labelledby={`${id}-cap`}>
  <figcaption class="ladder-box__top" id={`${id}-cap`}>
    <span class="label">Levels · price / R</span>
    <span class="label">1R = {formatPrice(model.oneR)}</span>
  </figcaption>

  <div class="ladder" role="img" aria-label={label}>
    <span class="ladder__zone ladder__zone--reward" style={`top:${pct(model.reward.top)};height:${pct(model.reward.bottom - model.reward.top)}`}></span>
    <span class="ladder__zone ladder__zone--risk" style={`top:${pct(model.risk.top)};height:${pct(model.risk.bottom - model.risk.top)}`}></span>
    <span class="ladder__axis"></span>
    {model.ticks.map((tick) => (
      <span class="ladder__tick" style={`top:${pct(tick.y)}`}>{tick.r === 0 ? '0' : formatR(tick.r, 0)}</span>
    ))}
    {model.levels.map((level) => {
      const nudged = Math.abs(level.labelY - level.y) > 0.05;
      return (
        <>
          <span class:list={['ladder__mark', `ladder__mark--${level.kind}`]} style={`top:${pct(level.y)}`}></span>
          {nudged && (
            <span
              class="ladder__leader"
              style={`top:${pct(Math.min(level.y, level.labelY))};height:${pct(Math.abs(level.labelY - level.y))}`}
            ></span>
          )}
          <span class:list={['lv', `lv--${level.kind}`, { 'lv--nudged': nudged }]} style={`top:${pct(level.labelY)}`}>
            <span class="lv__name">{level.name}</span>
            <span class="lv__line"></span>
            <span class="lv__px">{formatPrice(level.price)}</span>
            <span class="lv__r">{level.r === null ? '—' : formatR(level.r)}</span>
          </span>
        </>
      );
    })}
  </div>

  <details class="ladder-box__table">
    <summary>View as table</summary>
    <div class="table-scroll" role="region" aria-label="Price levels" tabindex="0">
      <table>
        <thead>
          <tr><th scope="col">Level</th><th scope="col" class="num">Price</th><th scope="col" class="num">R</th></tr>
        </thead>
        <tbody>
          {rows.map((level) => (
            <tr>
              <th scope="row">{level.kind === 'target' ? `Target ${level.name.slice(1)}` : level.name}</th>
              <td class="num">{formatPrice(level.price)}</td>
              <td class="num">{level.r === null ? '—' : formatR(level.r)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .ladder-box {
    display: grid; gap: 18px;
    padding: 18px 18px 16px;
    border: 1px solid var(--rule-2);
    background: var(--bg-raised);
  }
  .ladder-box__top { display: flex; justify-content: space-between; gap: 12px; }

  /* The plot. Left: R ticks (0–40px) and the axis at 48px. Right of the axis: one label row per level. */
  .ladder { --axis: 48px; position: relative; height: 420px; }
  .ladder__axis { position: absolute; left: var(--axis); top: 0; bottom: 0; width: 1px; background: var(--rule-2); }
  .ladder__zone { position: absolute; left: calc(var(--axis) + 1px); right: 0; }
  .ladder__zone--reward { background: linear-gradient(90deg, var(--fg), transparent 85%); opacity: 0.07; }
  .ladder__zone--risk {
    background: repeating-linear-gradient(-45deg, var(--hatch) 0 1px, transparent 1px 5px);
    opacity: 0.55;
  }

  .ladder__tick {
    position: absolute; left: 0; width: var(--axis);
    display: flex; align-items: center; gap: 6px;
    transform: translateY(-50%);
    font-size: 12px; line-height: 1; color: var(--fg-3); font-variant-numeric: tabular-nums;
  }
  .ladder__tick::after { content: ''; flex: 1; max-width: 8px; height: 1px; margin-left: auto; background: var(--rule-2); }

  /* the true price on the axis: a diamond (entry and exit filled in signal / ink) */
  .ladder__mark {
    position: absolute; left: calc(var(--axis) - 5px); width: 11px; height: 11px;
    transform: translateY(-50%) rotate(45deg);
    background: var(--fg); box-shadow: 0 0 0 2px var(--bg-raised);
  }
  .ladder__mark--entry { background: var(--signal-ui); }
  .ladder__mark--stop { background: var(--bg-raised); border: 1.5px solid var(--fg); }
  .ladder__leader { position: absolute; left: calc(var(--axis) + 10px); width: 1px; background: var(--fg-3); }

  .lv {
    position: absolute; left: calc(var(--axis) + 16px); right: 0;
    display: grid; grid-template-columns: auto minmax(12px, 1fr) auto 3.6em; align-items: center; column-gap: 10px;
    transform: translateY(-50%);
  }
  .lv__name {
    padding: 4px 7px; border: 1px solid var(--rule-2);
    font-size: 12px; font-weight: 650; letter-spacing: 0.07em; line-height: 1.1; text-transform: uppercase;
    background: var(--bg-raised);
  }
  .lv__line { height: 1px; background: var(--fg); opacity: 0.5; }
  .lv__px { font-size: 18px; line-height: 1; font-weight: 600; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .lv__r { font-size: 12px; color: var(--fg-2); text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }

  .lv--entry .lv__name { border-color: var(--signal-ui); }
  .lv--entry .lv__line { height: 2px; background: var(--signal-ui); opacity: 1; }
  .lv--stop .lv__name { border-color: var(--fg); }
  .lv--stop .lv__line { height: 0; background: none; opacity: 1; border-top: 1px dashed var(--fg); }
  .lv--exit .lv__name { background: var(--fg); border-color: var(--fg); color: var(--bg-raised); }
  .lv--exit .lv__line { opacity: 1; }
  .lv--nudged .lv__line { opacity: 0.3; }

  /* the table twin */
  .ladder-box__table { border-top: 1px solid var(--rule); padding-top: 12px; }
  .ladder-box__table summary {
    display: inline-flex; align-items: center; gap: 8px; min-height: 32px; cursor: pointer;
    font-size: 13px; font-weight: 550; color: var(--fg-2); list-style: none;
  }
  .ladder-box__table summary::-webkit-details-marker { display: none; }
  .ladder-box__table summary::before {
    content: '+'; display: inline-grid; place-items: center; width: 16px; height: 16px;
    border: 1px solid var(--rule-2); font-size: 12px; line-height: 1; color: var(--fg);
  }
  .ladder-box__table[open] summary::before { content: '−'; }
  .ladder-box__table summary:hover { color: var(--fg); }
  .table-scroll { margin-top: 10px; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; font-variant-numeric: tabular-nums; }
  th, td { padding: 8px 12px 8px 0; border-bottom: 1px solid var(--rule); text-align: left; }
  thead th {
    font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-3);
    border-bottom-color: var(--rule-2);
  }
  tbody th { font-weight: 550; }
  .num { text-align: right; padding-right: 0; padding-left: 12px; }

  @media (width < 640px) {
    .ladder-box { padding: 16px 14px 14px; }
    .ladder { --axis: 40px; height: 360px; }
    .lv { left: calc(var(--axis) + 12px); column-gap: 8px; grid-template-columns: auto minmax(8px, 1fr) auto 3.4em; }
    .lv__px { font-size: 17px; }
  }
</style>
