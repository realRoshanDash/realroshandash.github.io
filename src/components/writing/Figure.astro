---
/**
 * A numbered figure for MDX posts (design spec §4.17). The image sits in the text column; on desktop the caption
 * hangs in the margin column, bottom-aligned, as "FIG. 3" over the text. On phones it goes below.
 *
 *   <Figure src={photo} alt="…" n="1" caption="…" />                 a photo: 1px rule, no filters
 *   <Figure kind="diagram" n="2" caption="…"><svg role="img" …/></Figure>   a house diagram: raised box, crop marks
 *
 * Styled in src/styles/prose.css with the rest of the article.
 */
import type { ImageMetadata } from 'astro';
import Photo from '@/components/ui/Photo.astro';

interface Props {
  /** An imported image. Omit to pass the figure's content (an inline SVG) as children. */
  src?: ImageMetadata;
  alt?: string;
  caption?: string;
  n?: string | number;
  kind?: 'image' | 'diagram';
  /** Let the media run across the margin column too */
  wide?: boolean;
}
const { src, alt = '', caption, n, kind = 'image', wide = false } = Astro.props;
---

<figure class:list={['figure', `figure--${kind}`, { wide }]}>
  <div class="figure__media">
    {kind === 'diagram' && (
      <>
        <span class="crop crop--tl" aria-hidden="true"></span><span class="crop crop--tr" aria-hidden="true"></span>
        <span class="crop crop--bl" aria-hidden="true"></span><span class="crop crop--br" aria-hidden="true"></span>
      </>
    )}
    {src ? (
      <Photo
        src={src}
        alt={alt}
        widths={[480, 760, 1040, 1520]}
        sizes={wide ? '(min-width: 1024px) 66vw, 100vw' : '(min-width: 1024px) 52vw, 100vw'}
      />
    ) : (
      <slot />
    )}
  </div>
  {(caption || n !== undefined) && (
    <figcaption class="figure__cap">
      {n !== undefined && <span class="figure__n">Fig. {n}</span>}
      {caption}
    </figcaption>
  )}
</figure>
