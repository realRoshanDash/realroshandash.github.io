---
/** One post in a list: a row on the grid, not a card (design spec §4.12). Looks intentional with 1 entry or 50. */
import type { Post } from '@/lib/content';
import { formatDateISO } from '@/lib/format';

interface Props {
  post: Post;
  /** "No. 004": position by publish date, oldest = 001 */
  no: number;
  minutes: number;
  /** The post's page; omitted while /blog/[slug] isn't built, so the row never links to a 404. */
  href?: string;
  reveal?: number;
}
const { post, no, minutes, href, reveal = 0 } = Astro.props;
const iso = formatDateISO(post.data.published);
const vtName = `post-${post.id.toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/^(\d)/, 'p-$1')}`;
---

<li class="post-row" data-reveal={reveal}>
  <p class="post-row__meta label">
    <span class="no">No. {String(no).padStart(3, '0')}</span>
    <time datetime={iso}>{iso}</time>
    <span class="min">{minutes} min</span>
  </p>
  <h3 class="post-row__title t-h3">
    {href ? <a href={href} style={`view-transition-name: ${vtName}`}>{post.data.title}</a> : post.data.title}
    {post.data.draft && <span class="badge post-row__draft"><span class="badge__hatch" aria-hidden="true"></span>Draft</span>}
  </h3>
  <p class="post-row__desc">{post.data.description}</p>
  {post.data.tags.length > 0 && <p class="post-row__tags label">{post.data.tags.slice(0, 2).join(' · ')}</p>}
</li>

<style>
  .post-row {
    position: relative;
    display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter); row-gap: 6px;
    padding: 20px 0 24px;
    border-top: 1px solid var(--rule);
  }
  .post-row::before {
    content: ''; position: absolute; left: 0; right: 0; top: -1px;
    height: var(--signal-bar); background: var(--signal-ui);
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--dur-5) var(--ease-out);
  }
  .post-row:has(a):hover::before, .post-row:focus-within::before { transform: scaleX(1); }
  .post-row__meta { display: contents; }
  .post-row__meta .no { grid-column: 1 / 3; grid-row: 1; padding-top: 6px; }
  .post-row__meta time { grid-column: 1 / 3; grid-row: 2; }
  .post-row__meta .min { grid-column: 11 / 13; grid-row: 1; justify-self: end; padding-top: 6px; }
  .post-row__title { grid-column: 3 / 9; grid-row: 1; }
  .post-row__title a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size var(--dur-4) var(--ease-out);
  }
  .post-row:hover .post-row__title a { background-size: 100% 1px; }
  .post-row__title a::after { content: ''; position: absolute; inset: 0; }
  .post-row__title a:focus-visible { outline: none; }
  .post-row:has(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 4px; }
  .post-row__draft { margin-left: 12px; vertical-align: 0.2em; }
  .post-row__desc { grid-column: 3 / 9; grid-row: 2; max-width: 42em; font-size: 15px; line-height: 1.5; color: var(--fg-2); }
  .post-row__tags { grid-column: 9 / 11; grid-row: 1 / 3; padding-top: 6px; }
  @media (width < 1024px) {
    .post-row__title, .post-row__desc { grid-column: 3 / 9; }
    .post-row__tags { grid-column: 3 / 9; grid-row: 3; }
    .post-row__meta .min { grid-column: 1 / 3; grid-row: 3; justify-self: start; padding-top: 0; }
  }
  @media (width < 640px) {
    .post-row { grid-template-columns: 1fr; }
    .post-row__meta { display: flex; gap: 10px; flex-wrap: wrap; }
    .post-row__meta > * + *::before { content: '·'; margin-right: 10px; }
    .post-row__meta .no, .post-row__meta time, .post-row__meta .min { grid-column: auto; grid-row: auto; padding: 0; justify-self: auto; }
    .post-row__title, .post-row__desc, .post-row__tags { grid-column: 1; grid-row: auto; }
  }
</style>
