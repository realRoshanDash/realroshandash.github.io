---
/**
 * One post in a list: a row on the grid, not a card (design spec §4.12). Looks intentional with 1 entry or 50.
 * The title link stretches over the whole row; the row shows the focus ring and the signal top rule.
 */
import type { PostItem } from './posts';

interface Props {
  item: PostItem;
  /** Heading level of the title, so the page outline never skips a level */
  as?: 'h2' | 'h3' | 'h4';
  /** Scroll-reveal stagger index (spec §3.4); omit for no reveal */
  reveal?: number;
  /** Carry the post's view-transition-name. Only one element per name may exist on a page. */
  morph?: boolean;
}
const { item, as: Heading = 'h3', reveal, morph = true } = Astro.props;
---

<li class="post-row" data-reveal={reveal}>
  <p class="post-row__meta label">
    <span class="no">No. {item.no === undefined ? <span aria-hidden="true">{item.noLabel}</span> : item.noLabel}</span>
    <time datetime={item.iso}>{item.iso}</time>
    <span class="min">{item.minutes} min<span class="sr-only"> read</span></span>
  </p>
  <Heading class="post-row__title t-h3">
    <a href={item.href} style={morph ? `view-transition-name: ${item.vt}` : undefined}>{item.title}</a>
    {(item.archived || item.draft) && (
      <span class="post-row__badges">
        {item.archived && <span class="badge badge--plain">From the archive</span>}
        {item.draft && <span class="badge"><span class="badge__hatch" aria-hidden="true"></span>Draft</span>}
      </span>
    )}
  </Heading>
  <p class="post-row__desc">{item.description}</p>
  {item.tags.length > 0 && <p class="post-row__tags label">{item.tags.slice(0, 2).map((tag) => tag.label).join(' · ')}</p>}
</li>

<style>
  .post-row {
    position: relative;
    display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter); row-gap: 6px;
    padding: 20px 0 24px;
    border-top: 1px solid var(--rule);
  }
  /* the signal top rule draws in on hover and focus */
  .post-row::before {
    content: ''; position: absolute; left: 0; right: 0; top: -1px;
    height: var(--signal-bar); background: var(--signal-ui);
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--dur-5) var(--ease-out);
  }
  .post-row:hover::before, .post-row:focus-within::before { transform: scaleX(1); }
  .post-row__meta { display: contents; }
  .post-row__meta .no { grid-column: 1 / 3; grid-row: 1; padding-top: 6px; }
  .post-row__meta time { grid-column: 1 / 3; grid-row: 2; }
  .post-row__meta .min { grid-column: 11 / 13; grid-row: 1; justify-self: end; padding-top: 6px; }
  .post-row__title { grid-column: 3 / 9; grid-row: 1; }
  .post-row__title a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size var(--dur-4) var(--ease-out);
  }
  .post-row:hover .post-row__title a { background-size: 100% 1px; }
  /* the whole row is the link */
  .post-row__title a::after { content: ''; position: absolute; inset: 0; }
  .post-row__title a:focus-visible { outline: none; }
  .post-row:has(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 4px; }
  /* badges travel together after the title; middle, not a baseline offset: a hatched and a plain badge have
     different first baselines */
  .post-row__badges {
    display: inline-flex; gap: 6px; margin-left: 12px; white-space: nowrap;
    vertical-align: middle; position: relative; top: -0.08em;
  }
  .post-row__desc { grid-column: 3 / 9; grid-row: 2; max-width: 42em; font-size: 15px; line-height: 1.5; color: var(--fg-2); }
  .post-row__tags { grid-column: 9 / 11; grid-row: 1 / 3; padding-top: 6px; }

  @media (width < 1024px) {
    .post-row__title, .post-row__desc { grid-column: 3 / 9; }
    .post-row__tags { grid-column: 3 / 9; grid-row: 3; }
    .post-row__meta .min { grid-column: 1 / 3; grid-row: 3; justify-self: start; padding-top: 0; }
  }
  @media (width < 640px) {
    .post-row { grid-template-columns: minmax(0, 1fr); }
    .post-row__meta { display: flex; gap: 10px; flex-wrap: wrap; }
    .post-row__meta > * + *::before { content: '·'; margin-right: 10px; }
    .post-row__meta .no, .post-row__meta time, .post-row__meta .min { grid-column: auto; grid-row: auto; padding: 0; justify-self: auto; }
    .post-row__title, .post-row__desc, .post-row__tags { grid-column: 1; grid-row: auto; }
    /* on a phone the badges get their own line under the title, never a ragged indent */
    .post-row__badges { display: flex; margin: 8px 0 2px; top: 0; }
  }
</style>
