---
/**
 * Inline SVG icon set (design spec §4.1). Square caps, mitred joins, 1.5px strokes in currentColor.
 * Icons never carry meaning alone: the control always has a text label or an aria-label.
 * The arrows, check and ⌘ glyphs are not in the shipped Inter subset, so they are drawn here.
 */
export type IconName =
  | 'arrow-right' | 'arrow-up-right' | 'arrow-down-right' | 'arrow-up'
  | 'search' | 'close' | 'copy' | 'check' | 'lock' | 'rss' | 'loop' | 'theme';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size, class: className } = Astro.props;

const PATHS: Record<Exclude<IconName, 'theme' | 'search' | 'rss'>, string> = {
  'arrow-right': 'M2 8h11M9.5 4.5 13 8l-3.5 3.5',
  'arrow-up-right': 'M4.5 11.5l7-7M5.5 4.5h6v6',
  'arrow-down-right': 'M4.5 4.5l7 7M11.5 5.5v6h-6',
  'arrow-up': 'M8 13.5V3M4.5 6.5 8 3l3.5 3.5',
  close: 'M3.5 3.5l9 9M12.5 3.5l-9 9',
  copy: 'M5.5 5.5h8v8h-8zM2.5 10.5v-8h8',
  check: 'M3 8.5l3.2 3.2L13 4.8',
  lock: 'M3.5 7.5h9V14h-9zM5.5 7.5v-2a2.5 2.5 0 0 1 5 0v2',
  loop: 'M13 8a5 5 0 1 1-1.5-3.6M12 2.5V5H9.5',
};
const box = name === 'theme' ? 20 : 16;
const style = size ? `width:${size}px;height:${size}px` : undefined;
---

<svg
  class:list={['icon', `icon--${name}`, className]}
  viewBox={`0 0 ${box} ${box}`}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
  style={style}
>
  {name === 'theme' ? (
    <>
      <circle cx="10" cy="10" r="8.25"></circle>
      <path d="M10 1.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor" stroke="none"></path>
    </>
  ) : name === 'search' ? (
    <>
      <circle cx="7" cy="7" r="4.75"></circle>
      <path d="M10.5 10.5 14 14"></path>
    </>
  ) : name === 'rss' ? (
    <>
      <path d="M3 3a10 10 0 0 1 10 10M3 7.5A5.5 5.5 0 0 1 8.5 13"></path>
      <circle cx="3.75" cy="12.25" r="1.25" fill="currentColor" stroke="none"></circle>
    </>
  ) : (
    <path d={PATHS[name]}></path>
  )}
</svg>
