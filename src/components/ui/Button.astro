---
/** Button / link-button (design spec §4.7). Navigation is an <a>; actions are <button type="button">. */
import Icon, { type IconName } from '@/components/ui/Icon.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'text';
  href?: string;
  icon?: IconName;
  size?: 'md' | 'sm';
  class?: string;
  [attr: string]: unknown;
}
const { variant = 'secondary', href, icon, size = 'md', class: className, ...rest } = Astro.props;
const classes = [
  variant === 'text' ? 'link-btn' : 'btn',
  { 'btn--primary': variant === 'primary', 'btn--sm': size === 'sm' && variant !== 'text' },
  className,
];
---

{href ? (
  <a class:list={classes} href={href} {...rest}><span><slot /></span>{icon && <Icon name={icon} />}</a>
) : (
  <button class:list={classes} type="button" {...rest}><span><slot /></span>{icon && <Icon name={icon} />}</button>
)}
