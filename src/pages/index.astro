---
import { getCollection, render } from 'astro:content';
const [post] = await getCollection('blog', (p) => p.id === 'from-hating-vim-to-loving-it');
const { Content } = await render(post);
---
<html lang="en"><head><meta charset="utf-8" /><title>scaffold</title></head><body><Content />
<div id="md-test"></div></body></html>
