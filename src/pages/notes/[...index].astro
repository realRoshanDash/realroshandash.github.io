---
/**
 * /notes/ — short notes, newest first (dormant: design spec §4.21).
 *
 * A rest route instead of index.astro so the page can be absent: getStaticPaths yields /notes/ only while at
 * least one note is published, so until then the build has no page, no nav item, no sitemap entry and no feed
 * for notes (the feed in [feed].xml.ts and the nav in src/lib/nav.ts follow the same rule).
 */
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import NoteRow from '@/components/notes/NoteRow.astro';
import { SITE } from '@/data/site';
import { getNotes } from '@/lib/content';
import { pluralize } from '@/lib/format';
import { lsbStyle } from '@/lib/optical';

export const getStaticPaths = (async () => {
  const notes = await getNotes();
  return notes.length ? [{ params: { index: undefined }, props: { notes } }] : [];
}) satisfies GetStaticPaths;

const { notes } = Astro.props;
const description = 'Short notes: things learned, links worth keeping and small engineering findings.';
---

<Base title="Notes" description={description}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={`Notes — ${SITE.name}`} href="/notes/rss.xml" />
  <div class="wrap">
    <header class="ph g">
      <div class="ph__main">
        <p class="ph__route mono">/notes</p>
        <h1 class="ph__title t-page" style={lsbStyle('Notes')}>Notes</h1>
      </div>
      <div class="ph__aside">
        <p class="ph__desc">{description}</p>
        <a class="arrow-link" href="/notes/rss.xml">RSS feed<Icon name="rss" /></a>
      </div>
    </header>

    <section class="notes" aria-labelledby="notes-list">
      <div class="notes__head label">
        <h2 class="notes__count" id="notes-list">{pluralize(notes.length, 'note')}</h2>
        <span class="notes__cols" aria-hidden="true"><span>Date</span><span>Note</span><span>Tags</span></span>
      </div>
      <ol class="notes__list" role="list">
        {notes.map((note, i) => <NoteRow note={note} reveal={i < 5 ? i : 0} />)}
      </ol>
    </section>
  </div>
</Base>

<style>
  .ph { row-gap: 28px; align-items: end; padding-block: clamp(28px, 4vw, 64px) clamp(36px, 4.5vw, 64px); }
  .ph__main { grid-column: 1 / 9; display: grid; gap: clamp(12px, 1.6vw, 24px); }
  .ph__route { color: var(--fg-3); }
  .ph__aside { grid-column: 9 / 13; display: grid; justify-items: start; gap: 16px; padding-bottom: 8px; }
  .ph__desc { max-width: 30em; font-size: 15px; line-height: 1.5; color: var(--fg-2); }

  .notes { padding-bottom: var(--section-pad); }
  .notes__head {
    display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); column-gap: var(--gutter);
    padding: 14px 0 12px; border-top: 1px solid var(--rule-2);
  }
  .notes__count { grid-column: 1 / 3; grid-row: 1; font: inherit; letter-spacing: inherit; color: var(--fg); }
  .notes__cols { display: contents; }
  .notes__cols span:nth-child(1) { display: none; }
  .notes__cols span:nth-child(2) { grid-column: 3 / 9; grid-row: 1; }
  .notes__cols span:nth-child(3) { grid-column: 9 / 13; grid-row: 1; }
  .notes__list { border-bottom: 1px solid var(--rule); }

  @media (width < 1024px) {
    .ph__main { grid-column: 1 / -1; }
    .ph__aside { grid-column: 1 / 7; }
    .notes__cols span:nth-child(3) { display: none; }
  }
  @media (width < 640px) {
    .ph__aside { grid-column: 1 / -1; }
    .notes__cols { display: none; }
    .notes__count { grid-column: 1 / -1; }
  }
</style>
