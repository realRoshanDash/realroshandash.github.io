---
/**
 * /notes/<id>/ — one note (dormant: built only for published notes; design spec §4.21). Laid out like a post:
 * crumb, title, a ruled meta row, then the text in the prose column. An untitled note is titled by its date.
 */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import Prose from '@/components/notes/Prose.astro';
import { displayUrl } from '@/components/notes/display';
import avatar from '@/assets/avatar.jpg';
import { SITE } from '@/data/site';
import { adjacent, entryPath, getNotes, noteTitle } from '@/lib/content';
import { formatDateISO } from '@/lib/format';
import { lsbStyle } from '@/lib/optical';
import { excerpt } from '@/lib/text';

export const getStaticPaths = (async () => {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { id: note.id }, props: { note, notes } }));
}) satisfies GetStaticPaths;

const { note, notes } = Astro.props;
const { Content } = await render(note);
const { title, published, tags, link, image, imageAlt, draft } = note.data;
const iso = formatDateISO(published);
const { prev: older, next: newer } = adjacent(notes, note.id);
// "No. 001" is the oldest note (getNotes is newest first), like posts and trade ideas.
const no = String(notes.length - notes.findIndex((other) => other.id === note.id)).padStart(3, '0');
const pageTitle = noteTitle(note);
const description = excerpt(note.body ?? '', 160) || pageTitle;
---

<Base title={pageTitle} description={description} type="article" noindex={draft}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={`Notes — ${SITE.name}`} href="/notes/rss.xml" />
  {/* Search indexes Base's <main> (a draft preview is noindex, so it stays out); this names the result. */}
  <article class="wrap note" aria-labelledby="note-title" data-pagefind-meta="title[data-title]" data-title={pageTitle}>
    <header class="note-head g">
      <p class="note-head__crumb label" data-pagefind-ignore>
        <a href="/notes/">Notes</a><span aria-hidden="true">/</span><span>No. {no}</span>
      </p>
      {draft && <span class="badge note-head__draft"><span class="badge__hatch" aria-hidden="true"></span>Draft</span>}
      {title ? (
        <h1 class="note-head__title t-post" id="note-title" style={lsbStyle(title)}>{title}</h1>
      ) : (
        <h1 class="note-head__title note-head__title--date t-post" id="note-title" style={lsbStyle(iso, 'thin')}>
          <span class="sr-only">Note from </span>{iso}
        </h1>
      )}
    </header>

    <dl class="note-meta" data-pagefind-ignore>
      <div class="note-meta__author">
        <dt class="sr-only">Author</dt>
        <dd>
          <Image class="note-meta__avatar" src={avatar} alt="" width={40} height={40} densities={[1, 2]} />
          <span class="note-meta__name">{SITE.name}<span>{SITE.location}</span></span>
        </dd>
      </div>
      {title && <div><dt class="label">Published</dt><dd><time datetime={iso}>{iso}</time></dd></div>}
      {tags.length > 0 && <div><dt class="label">Tags</dt><dd>{tags.join(' · ')}</dd></div>}
      {link && (
        <div class="note-meta__link">
          <dt class="label">Link</dt>
          <dd><a class="ext-link" href={link} rel="noopener">{displayUrl(link, 40)}<Icon name="arrow-up-right" /></a></dd>
        </div>
      )}
    </dl>

    <Prose class="note-body">
      {image && <Image class="note-body__img" src={image} alt={imageAlt ?? ''} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, calc(100vw - 40px)" />}
      <Content />
    </Prose>

    <nav class="pager g" aria-label="More notes" data-pagefind-ignore>
      {older && (
        <a class="pager__link pager__link--older" href={entryPath('notes', older.id)}>
          <span class="label"><Icon name="arrow-right" />Older</span>
          <span class="pager__title">{noteTitle(older)}</span>
          <span class="label pager__date">{formatDateISO(older.data.published)}</span>
        </a>
      )}
      {newer && (
        <a class="pager__link pager__link--newer" href={entryPath('notes', newer.id)}>
          <span class="label">Newer<Icon name="arrow-right" /></span>
          <span class="pager__title">{noteTitle(newer)}</span>
          <span class="label pager__date">{formatDateISO(newer.data.published)}</span>
        </a>
      )}
      <a class="route-link pager__all" href="/notes/">
        <span class="route">/notes</span><span class="leader" aria-hidden="true"></span><span class="text">All notes<Icon name="arrow-right" /></span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .note { padding-bottom: var(--section-pad); }

  .note-head { row-gap: 20px; padding-top: clamp(28px, 4vw, 64px); }
  .note-head__crumb { grid-column: 1 / 10; display: flex; flex-wrap: wrap; gap: 0 10px; }
  .note-head__crumb a { color: var(--fg-2); transition: color var(--dur-2) linear; }
  .note-head__crumb a:hover { color: var(--fg); }
  .note-head__draft { grid-column: 10 / 13; justify-self: end; align-self: center; }
  .note-head__title { grid-column: 1 / 11; padding-bottom: clamp(28px, 3.5vw, 48px); }
  .note-head__title--date { font-weight: 250; font-variant-numeric: tabular-nums; }

  .note-meta {
    display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 16px;
    padding: 14px 0; border-block: 1px solid var(--rule);
  }
  .note-meta > div { grid-column: span 2; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .note-meta dd { font-size: 14px; line-height: 1.45; font-weight: 550; font-variant-numeric: tabular-nums; }
  .note-meta .note-meta__author { grid-column: 1 / 4; }
  .note-meta__author dd { display: flex; align-items: center; gap: 12px; }
  .note-meta__avatar { width: 40px; height: 40px; flex: none; }
  .note-meta__name { display: flex; flex-direction: column; font-weight: 600; }
  .note-meta__name span { font-size: 12.5px; font-weight: 450; color: var(--fg-3); }
  .note-meta .note-meta__link { grid-column: span 4; }
  .note-meta__link a { min-height: 24px; overflow-wrap: anywhere; }
  .note-meta__link a:hover { color: var(--signal-text); }

  .note :global(.note-body) { padding-top: clamp(36px, 4.5vw, 64px); }
  /* landscape photos fill the text column; portrait ones stop at most of a screen. The width cap is the column
     (less the margin column it hangs past), so on a phone the photo never runs off the screen. */
  .note :global(.note-body__img) {
    width: auto; height: auto;
    max-width: min(calc(100% - var(--hang, 0px)), var(--measure)); max-height: min(80svh, 760px);
    border: 1px solid var(--rule);
  }

  .pager { row-gap: 16px; margin-top: clamp(48px, 6vw, 96px); padding-top: 18px; border-top: 1px solid var(--rule-2); }
  .pager__link {
    position: relative; display: flex; flex-direction: column; gap: 8px; padding: 6px 0 4px;
  }
  .pager__link--older { grid-column: 1 / 7; }
  .pager__link--newer { grid-column: 7 / 13; align-items: flex-end; text-align: right; }
  .pager__link .label { display: inline-flex; align-items: center; gap: 8px; }
  .pager__link--older .label :global(.icon) { transform: scaleX(-1); }
  .pager__link :global(.icon) { width: 14px; height: 14px; }
  .pager__title { font-size: var(--fs-h3); line-height: 1.15; font-weight: 650; letter-spacing: var(--tr-heading); max-width: 24em; }
  .pager__link:hover .pager__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .pager__date { color: var(--fg-3); }
  .pager__all { grid-column: 1 / -1; margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--rule); }
  .route-link { display: flex; align-items: baseline; gap: 10px; min-height: 32px; }
  .route-link .route { font: 12.5px var(--font-mono, monospace); color: var(--fg-3); transition: color var(--dur-2) linear; }
  .route-link .leader {
    flex: 1; min-width: 24px; height: 1px; align-self: center;
    background: repeating-linear-gradient(90deg, var(--rule-2) 0 1px, transparent 1px 5px);
  }
  .route-link .text { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 550; }
  .route-link .text :global(.icon) { transition: transform var(--dur-4) var(--ease-out); }
  .route-link:hover .route { color: var(--signal-text); }
  .route-link:hover .text :global(.icon), .route-link:focus-visible .text :global(.icon) { transform: translateX(4px); }

  @media (width < 1024px) {
    .note-head__crumb { grid-column: 1 / 7; }
    .note-head__draft { grid-column: 7 / 9; }
    .note-head__title { grid-column: 1 / -1; }
    .note-meta > div { grid-column: span 2; }
    .note-meta .note-meta__author { grid-column: 1 / -1; }
    .note-meta .note-meta__link { grid-column: span 4; }
    .pager__link--older { grid-column: 1 / 5; }
    .pager__link--newer { grid-column: 5 / 9; }
  }
  @media (width < 640px) {
    .note-head__crumb { grid-column: 1 / 4; }
    .note-head__draft { grid-column: 4 / 5; }
    .note-meta > div { grid-column: span 2; }
    .note-meta .note-meta__link { grid-column: 1 / -1; }
    .pager__link--older, .pager__link--newer { grid-column: 1 / -1; align-items: flex-start; text-align: left; }
  }
</style>
